APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=
APPWRITE_BOOKINGS_COLLECTION_ID=bookings
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: use Google Places instead of OpenStreetMap/Overpass for nearby hotels/areas.
# Requires Google billing and an API key. Leave blank to use the OSM-based free fallback.
GOOGLE_MAPS_API_KEY=
PORT=10000

# Optional free GeoNames account for structured nearby cities/areas. OSM remains the default.
GEONAMES_USERNAME=
